{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "superquest/quest",
  "version": "1.0.3",
  "title": "SuperQuest",
  "category": "embed",
  "description": "Insert a quest.",
  "keywords": [
    "quest",
    "quiz",
    "gamification",
    "learning",
    "poll",
    "survey",
    "rating",
    "game"
  ],
  "textdomain": "superquest",
  "attributes": {
    "questId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "example": {
    "attributes": {
      "questId": "__example__"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
